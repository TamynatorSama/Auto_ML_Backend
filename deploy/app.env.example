# Install as /etc/automl/app.env on the Linux server (mode 0640, group docker).
# Keep the same AUTOML_SECRET_KEY as the existing database: it encrypts saved keys.
DATABASE_URL=postgresql://automl:URL_ENCODED_PASSWORD@127.0.0.1:5432/automl_live
AUTOML_SECRET_KEY=REPLACE_WITH_NEW_FERNET_KEY
AUTOML_APP_ORIGIN=https://YOUR_SERVER.YOUR_TAILNET.ts.net
AUTOML_BACKEND=sandbox
AUTOML_SANDBOX_URL=http://127.0.0.1:8765
AUTOML_SANDBOX_TOKEN=REPLACE_WITH_SANDBOX_TOKEN

# Needed for email verification and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
MAIL_FROM=REPLACE_ME

# Optional OAuth sign-in. Register the callback at
# https://YOUR_SERVER.YOUR_TAILNET.ts.net/api/auth/oauth/PROVIDER/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
